# Copy this to .env on the VPS and fill in real values.
# NEVER commit the real .env.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/successwa?sslmode=require&channel_binding=require
PORT=8000

# ============ EMAIL (SMTP via Resend) ============
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM=Elite Tax & Wealth <onboarding@resend.dev>

